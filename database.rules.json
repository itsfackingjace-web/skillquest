          },
          "$o": {
            ".validate": false
          }
        },
        "m": {
          "$uid": {
            ".write": "auth != null && ((root.child('guilds').child($g).child('info').child('lead').val()===auth.uid && (newData.exists() || auth.uid!==$uid || newData.parent().parent().child('info').child('lead').val()!==auth.uid)) || (auth.uid===$uid && !data.exists() && newData.child('r').val()==='m' && root.child('ginv').child($uid).child($g).exists()) || (auth.uid===$uid && !data.exists() && newData.child('r').val()==='l' && !root.child('guilds').child($g).child('info').exists() && newData.parent().parent().child('info').child('lead').val()===auth.uid) || (auth.uid===$uid && !newData.exists() && newData.parent().parent().child('info').child('lead').val()!==auth.uid) || (root.child('guilds').child($g).child('m').child(auth.uid).child('r').val()==='o' && data.child('r').val()==='m' && !newData.exists()))",
            ".validate": "newData.hasChildren(['r','n'])",
            "r": {
              ".validate": "(newData.val()==='l' || newData.val()==='o' || newData.val()==='m') && (newData.val()==='l') === (newData.parent().parent().parent().child('info').child('lead').val()===$uid)"
            },
            "n": {
              ".validate": "newData.isString() && newData.val().length<=12"
            },
            "j": {
              ".validate": "newData.isNumber()"
