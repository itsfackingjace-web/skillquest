          },
          "d": {
            ".validate": "newData.isNumber() || (newData.isString() && newData.val().length<=200)"
          },
          "u": {
            ".validate": true
          },
          "t": {
            ".validate": true
          },
          "$o": {
            ".validate": false
          }
        }
      }
    },
    "gname": {
      ".read": "auth != null",
      "$n": {
        ".write": "auth != null && ((!data.exists() && newData.isString() && !root.child('guilds').child(newData.val()).exists() && newData.parent().parent().child('guilds').child(newData.val()).child('info').child('lead').val()===auth.uid) || (!newData.exists() && root.child('guilds').child(data.val()).child('info').child('lead').val()===auth.uid))"
      }
    },
    "gmem": {
      "$uid": {
        ".read": "auth != null && auth.uid===$uid",
        ".write": "auth != null && auth.uid===$uid && (!newData.exists() || newData.parent().parent().child('guilds').child(newData.val()).child('m').child(auth.uid).exists())",
        ".validate": "newData.isString() && newData.val().length<=16"
      }
    },
    "ginv": {
      "$uid": {
        ".read": "auth != null && auth.uid===$uid",
        "$g": {
          ".write": "auth != null && ((auth.uid===$uid && !newData.exists()) || (newData.child('by').val()===auth.uid && ((root.child('guilds').child($g).child('m').child(auth.uid).child('r').val()==='l' || root.child('guilds').child($g).child('m').child(auth.uid).child('r').val()==='o'))))",
          ".validate": "newData.hasChildren(['gn','tag','by','t']) && newData.child('t').val()===now",
          "gn": {
