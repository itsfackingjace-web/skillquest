{
  "rules": {
    "saves": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['json', 'savedAt']) && newData.child('json').isString() && newData.child('json').val().length < 3000000 && newData.child('savedAt').isNumber()"
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "n": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "loc": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "x": {
          ".validate": "newData.isNumber()"
        },
        "y": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "chat": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('u').val() === auth.uid",
        ".validate": "newData.hasChildren(['u', 'n', 'm', 't'])",
        "u": {
          ".validate": "newData.isString()"
        },
        "n": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "m": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "t": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "og": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && !data.exists() && now < 1796277600000",
        ".validate": "newData.val() === now"
      }
    },
    "world": {
      "res": {
        ".read": "auth != null",
        "$loc": {
          "$cell": {
            ".write": "auth != null && ((!data.exists() && newData.child('at').val() === now) || (data.exists() && !newData.exists() && data.child('at').val() < now - 230000))",
            ".validate": "newData.hasChildren(['t', 'at']) && newData.child('t').isString() && newData.child('t').val().length < 16"
          }
        }
      }
    },
    "mobs": {
      ".read": "auth != null",
      "$loc": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "hits": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$id": {
          ".write": "auth != null && (!data.exists() || auth.uid === $uid)",
          ".validate": "newData.hasChildren(['id', 'd']) && newData.child('d').isNumber() && newData.child('d').val() <= 50 && newData.child('id').isString()"
        }
      }
    },
    "profiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['n', 'nl']) && newData.child('n').isString() && newData.child('n').val().length <= 12 && newData.child('nl').isString()"
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "$f": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "pm": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$id": {
          ".write": "auth != null && ((!data.exists() && newData.child('f').val() === auth.uid) || (auth.uid === $uid && !newData.exists()))",
          ".validate": "newData.hasChildren(['f', 'n', 'm', 't']) && newData.child('m').isString() && newData.child('m').val().length > 0 && newData.child('m').val().length <= 80 && newData.child('n').isString() && newData.child('n').val().length <= 12 && newData.child('t').val() === now"
        }
      }
    },
    "fires": {
      ".read": "auth != null",
      "$loc": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "bugs": {
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('u').val() === auth.uid",
        ".validate": "newData.hasChildren(['u', 'what', 't']) && newData.child('what').isString() && newData.child('what').val().length <= 1500 && newData.child('t').val() === now && (!newData.child('shot').exists() || (newData.child('shot').isString() && newData.child('shot').val().length < 400000))"
      }
    },
    "houses": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "freq": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$from": {
          ".write": "auth != null && (auth.uid === $from || auth.uid === $uid)",
          ".validate": "newData.hasChildren(['n', 't']) && newData.child('n').isString() && newData.child('n').val().length <= 12"
        }
      }
    },
    "build": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "names": {
      ".read": "auth != null",
      "$key": {
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
        ".validate": "newData.isString() && newData.val() === auth.uid"
      }
    },
    "treq": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".read": "auth != null && auth.uid === $from",
          ".write": "auth != null && (auth.uid === $from || auth.uid === $to) && (!newData.exists() || auth.uid === $from)",
          ".validate": "newData.hasChildren(['n', 't']) && newData.child('n').isString() && newData.child('n').val().length <= 12 && newData.child('t').val() === now"
        }
      }
    },
    "trades": {
      "$tid": {
        ".read": "auth != null && ($tid.beginsWith(auth.uid + '_') || $tid.endsWith('_' + auth.uid))",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && ($tid.beginsWith(auth.uid + '_') || $tid.endsWith('_' + auth.uid))",
          ".validate": "newData.hasChildren(['g', 't']) && newData.child('g').isNumber() && newData.child('g').val() >= 0 && newData.child('t').val() === now",
          "i": {
            "$k": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            }
          },
          "a": {
            ".validate": "newData.isString() && newData.val().length < 4000"
          },
          "c": {
            ".validate": "newData.isString() && newData.val().length < 4000"
          },
          "d": {
            ".validate": "newData.isString() && newData.val().length < 4000"
          },
          "$other": {
            ".validate": "$other === 'g' || $other === 't'"
          }
        }
      }
    },
    "graves": {
      ".read": "auth != null",
      "$gid": {
        ".write": "auth != null && ((!data.exists() && newData.child('u').val() === auth.uid && newData.child('at').val() === now) || (data.exists() && !newData.exists() && (data.child('u').val() === auth.uid || !data.child('i').exists() || data.child('at').val() < now - 900000)))",
        ".validate": "newData.hasChildren(['u', 'n', 'loc', 'x', 'y', 'at']) && newData.child('n').isString() && newData.child('n').val().length <= 12 && newData.child('loc').isString() && newData.child('loc').val().length <= 40 && newData.child('x').isNumber() && newData.child('y').isNumber()",
        "i": {
          "$k": {
            ".write": "auth != null && data.exists() && (!newData.exists() || (newData.isNumber() && newData.val() < data.val()))",
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1000000 && $k.length < 24"
          }
        }
      }
    },
    "fx": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['s', 'k', 'loc', 't']) && newData.child('k').isString() && newData.child('k').val().length <= 4 && newData.child('loc').isString() && newData.child('loc').val().length <= 40 && newData.child('t').val() === now"
      }
    },
    "pvp": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$id": {
          ".write": "auth != null && ((!data.exists() && newData.child('f').val() === auth.uid) || (auth.uid === $uid && !newData.exists()))",
          ".validate": "newData.hasChildren(['f', 'n', 'd', 'k', 't']) && newData.child('d').isNumber() && newData.child('d').val() >= 0 && newData.child('d').val() <= 2 && newData.child('k').isString() && newData.child('k').val().length <= 4 && newData.child('n').isString() && newData.child('n').val().length <= 12 && newData.child('t').val() === now"
        }
      }
    },
    "lb": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['n', 't']) && newData.child('n').isString() && newData.child('n').val().length <= 12 && newData.child('t').val() === now"
      }
    },
    "wb": {
      ".read": "auth != null",
      "$slot": {
        "d": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200000"
          }
        }
      }
    },
    "trust": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "$f": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "chests": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('trust/'+$uid+'/'+auth.uid).val() === true)",
        "$cid": {
          ".write": "auth != null && (auth.uid === $uid || root.child('trust/'+$uid+'/'+auth.uid).val() === true)",
          ".validate": "newData.hasChildren(['v']) && newData.child('v').isNumber()",
          "i": {
            "$k": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
            }
          },
          "v": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "farm": {
      ".read": "auth != null",
      "$area": {
        "$cell": {
          ".write": "auth != null",
          ".validate": "$area.length < 16 && $cell.length < 12 && newData.hasChildren(['c','t']) && newData.child('c').isString() && newData.child('c').val().length < 12 && newData.child('t').isNumber() && (!newData.child('g').exists() || newData.child('g').isNumber()) && (!newData.child('w').exists() || newData.child('w').isNumber()) && (!newData.child('e').exists() || newData.child('e').isNumber())"
        }
      }
    },
    "market": {
      "offers": {
        ".read": "auth != null",
        "$id": {
          ".write": "auth != null && ((!data.exists() && newData.child('u').val() === auth.uid) || (data.exists() && data.child('u').val() === auth.uid) || (data.exists() && newData.exists() && newData.child('u').val() === data.child('u').val() && newData.child('k').val() === data.child('k').val() && newData.child('s').val() === data.child('s').val() && newData.child('p').val() === data.child('p').val() && newData.child('q').val() === data.child('q').val() && newData.child('t').val() === data.child('t').val() && newData.child('f').val() > data.child('f').val()))",
          ".validate": "newData.hasChildren(['u','k','s','p','q','f']) && newData.child('k').isString() && newData.child('k').val().length < 24 && (newData.child('s').val() === 'b' || newData.child('s').val() === 's') && newData.child('p').isNumber() && newData.child('p').val() >= 1 && newData.child('p').val() <= 10000000 && newData.child('q').isNumber() && newData.child('q').val() >= 1 && newData.child('q').val() <= 100000 && newData.child('f').isNumber() && newData.child('f').val() >= 0 && newData.child('f').val() <= newData.child('q').val() && newData.child('t').isNumber() && newData.child('t').val() <= now + 60000"
        }
      },
      "box": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$id": {
            ".write": "auth != null && (!data.exists() || auth.uid === $uid)",
            ".validate": "newData.hasChildren(['k','n']) && newData.child('k').isString() && newData.child('k').val().length < 24 && newData.child('n').isNumber() && newData.child('n').val() > 0"
          }
        }
      },
      "last": {
        ".read": "auth != null",
        "$k": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['p','t']) && newData.child('p').isNumber()"
        }
      }
    },
    "bak": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$k": {
          ".validate": "newData.hasChildren(['json', 'at', 'tag']) && newData.child('json').isString() && newData.child('json').val().length < 3000000 && newData.child('at').isNumber() && newData.child('tag').isString() && newData.child('tag').val().length < 20"
        }
      }
    },
    "devs": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "assets": {
      "live": {
        ".read": true,
        ".write": "auth != null && root.child('devs').child(auth.uid).val() === true"
      },
      "draft": {
        ".read": "auth != null && root.child('devs').child(auth.uid).val() === true",
        ".write": "auth != null && root.child('devs').child(auth.uid).val() === true"
      },
      "hist": {
        ".read": "auth != null && root.child('devs').child(auth.uid).val() === true",
        ".write": "auth != null && root.child('devs').child(auth.uid).val() === true"
      }
    },
    "dreq": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".read": "auth != null && auth.uid === $from",
          ".write": "auth != null && (auth.uid === $from || auth.uid === $to) && (!newData.exists() || auth.uid === $from)",
          ".validate": "newData.hasChildren(['n', 't']) && newData.child('n').isString() && newData.child('n').val().length <= 12 && newData.child('t').val() === now",
          "s": {
            ".validate": "newData.isString() && newData.val().length <= 12"
          },
          "k": {
            ".validate": "newData.isString() && newData.val().length <= 8"
          }
        }
      }
    },
    "duels": {
      "$tid": {
        ".read": "auth != null && ($tid.beginsWith(auth.uid + '_') || $tid.endsWith('_' + auth.uid))",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && ($tid.beginsWith(auth.uid + '_') || $tid.endsWith('_' + auth.uid))",
          ".validate": "newData.hasChildren(['g', 't']) && newData.child('g').isNumber() && newData.child('g').val() >= 0 && newData.child('t').val() === now",
          "i": {
            "$k": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            }
          },
          "a": {
            ".validate": "newData.isString() && newData.val().length < 4000"
          },
          "c": {
            ".validate": "newData.isString() && newData.val().length < 4000"
          },
          "d": {
            ".validate": "newData.isString() && newData.val().length < 4000"
          },
          "$other": {
            ".validate": "$other === 'g' || $other === 't'"
          },
          "f": {
            ".validate": "newData.isString() && newData.val().length < 4000"
          },
          "l": {
            ".validate": "newData.isString() && newData.val().length < 4000"
          },
          "s": {
            ".validate": "newData.isString() && newData.val().length <= 12"
          },
          "k": {
            ".validate": "newData.isString() && newData.val().length <= 8"
          },
          "m": {
            ".validate": "newData.isString() && newData.val().length < 4000"
          }
        }
      }
    },
    "wev": {
      ".read": "auth != null",
      "$wk": {
        "t": {
          ".write": "auth != null && $wk.matches(/^[0-9]{1,6}$/)",
          ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 500"
        },
        "p": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $wk.matches(/^[0-9]{1,6}$/)",
            ".validate": "newData.hasChildren(['n', 'c']) && newData.child('n').isString() && newData.child('n').val().length <= 12 && newData.child('c').isNumber() && newData.child('c').val() >= 0 && newData.child('c').val() <= 1000000"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
