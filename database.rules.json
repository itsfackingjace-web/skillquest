{
  "rules": {
    "saves": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['json', 'savedAt']) && newData.child('json').isString() && newData.child('json').val().length < 3000000 && newData.child('savedAt').isNumber()"
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "n": { ".validate": "newData.isString() && newData.val().length <= 12" },
        "loc": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "x": { ".validate": "newData.isNumber()" },
        "y": { ".validate": "newData.isNumber()" }
      }
    },
    "chat": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('u').val() === auth.uid",
        ".validate": "newData.hasChildren(['u', 'n', 'm', 't'])",
        "u": { ".validate": "newData.isString()" },
        "n": { ".validate": "newData.isString() && newData.val().length <= 12" },
        "m": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
        "t": { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    }
  }
}
