            "$o": {
              ".validate": false
            }
          }
        },
        "q": {
          ".write": "auth != null && root.child('guilds').child($g).child('m').child(auth.uid).exists() && ((root.child('guilds').child($g).child('m').child(auth.uid).child('r').val()==='l' || root.child('guilds').child($g).child('m').child(auth.uid).child('r').val()==='o') || (data.exists() && newData.exists() && newData.child('k').val()===data.child('k').val() && newData.child('goal').val()===data.child('goal').val() && newData.child('t').val()===data.child('t').val() && newData.child('p').val()>=data.child('p').val() && newData.child('p').val()<=data.child('p').val()+5000))",
          ".validate": "newData.hasChildren(['k','goal','p']) && ((newData.child('k').val()==='fish' && newData.child('goal').val()===50000) || ((newData.child('k').val()==='wood' || newData.child('k').val()==='mine' || newData.child('k').val()==='forage') && newData.child('goal').val()===100000))",
          "p": {
            ".validate": "newData.isNumber() && newData.val()>=0 && newData.val()<=newData.parent().child('goal').val()"
          },
          "c": {
            "$u": {
              ".validate": "newData.isNumber()"
            }
          }
        },
        "prog": {
          ".write": "auth != null && (((root.child('guilds').child($g).child('m').child(auth.uid).child('r').val()==='l' || root.child('guilds').child($g).child('m').child(auth.uid).child('r').val()==='o') && data.child('qd').exists() && newData.child('qd').val()===data.child('qd').val()+1 && root.child('guilds').child($g).child('q').child('done').val()===1 && !newData.parent().child('q').exists()) || (!data.exists() && !root.child('guilds').child($g).child('info').exists() && newData.parent().child('info').child('lead').val()===auth.uid && newData.child('qd').val()===0))",
          "qd": {
            ".validate": "newData.isNumber()"
          },
          "$o": {
            ".validate": false
          }
        },
        "perm": {
          ".write": "auth != null && (root.child('guilds').child($g).child('info').child('lead').val()===auth.uid || (!root.child('guilds').child($g).child('info').exists() && newData.parent().child('info').child('lead').val()===auth.uid))",
          "$rk": {
            ".validate": "($rk==='o' || $rk==='m') && newData.isNumber() && newData.val()>=-1 && newData.val()<=100000"
          }
        },
        "bank": {
          ".write": "auth != null && root.child('guilds').child($g).child('m').child(auth.uid).exists() && newData.child('v').val()===(data.child('v').exists() ? data.child('v').val() : 0)+1 && newData.child('lid').isString() && !root.child('glog').child($g).child(newData.child('lid').val()).exists() && newData.parent().parent().parent().child('glog').child($g).child(newData.child('lid').val()).exists()",
          "i": {
            "$k": {
              ".validate": "newData.isNumber() && newData.val()>=0 && newData.val()<=100000000"
            }
          },
          "v": {
            ".validate": "newData.isNumber()"
          },
          "lid": {
            ".validate": "newData.isString() && newData.val().length<=24"
          },
          "$o": {
            ".validate": false
          }
        },
        "isl": {
          ".write": "auth != null && (root.child('guilds').child($g).child('m').child(auth.uid).child('r').val()==='l' || root.child('guilds').child($g).child('m').child(auth.uid).child('r').val()==='o')",
          "$c": {
            ".validate": "newData.isString() && newData.val().length<=12 && $c.matches(/^[0-9]{1,5}$/)"
          }
        },
        "wd": {
          "$uid": {
            ".write": "auth != null && auth.uid===$uid && root.child('guilds').child($g).child('m').child(auth.uid).exists()",
            "d": {
              ".validate": "newData.isNumber()"
            },
            "n": {
              ".validate": "newData.isNumber()"
            },
            "$o": {
              ".validate": false
            }
          }
        },
        "$o": {
          ".validate": false
        }
      }
    },
    "glog": {
      "$g": {
        ".read": "auth != null && (root.child('guilds').child($g).child('m').child(auth.uid).child('r').val()==='l' || root.child('guilds').child($g).child('m').child(auth.uid).child('r').val()==='o')",
        ".write": "auth != null && !newData.exists() && root.child('guilds').child($g).child('info').child('lead').val()===auth.uid",
        "$id": {
          ".write": "auth != null && !data.exists() && root.child('guilds').child($g).child('m').child(auth.uid).exists() && newData.child('u').val()===auth.uid",
          ".validate": "newData.hasChildren(['u','n','w','k','t']) && newData.child('t').val()===now",
          "n": {
