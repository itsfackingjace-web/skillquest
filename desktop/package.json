{
  "name": "skillquest",
  "productName": "SkillQuest",
  "version": "1.0.1",
  "description": "SkillQuest for Windows",
  "author": "SkillQuest",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.skillquestmmo.game",
    "productName": "SkillQuest",
    "files": ["main.js", "preload.js", "signin.html", "offline/**", "icon.png"],
    "directories": { "output": "dist" },
    "win": { "icon": "icon.png" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SkillQuest",
      "artifactName": "SkillQuest-Setup.exe"
    },
    "portable": { "artifactName": "SkillQuest-Portable.exe" }
  }
}
